<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign pubs = site.data.resume.publications | sort: 'date' | reverse %}
  {% for entry in pubs %}
    <li class="list-group-item">
      <div class="publication-single">
        {%- comment -%} Title (linked) {%- endcomment -%}
        {%- if entry.url -%}
          <strong><a href="{{ entry.url }}">{{ entry.name }}</a></strong>
        {%- else -%}
          <strong>{{ entry.name }}</strong>
        {%- endif -%}
        {%- comment -%} Authors then Publisher, all on one line {%- endcomment -%}
        {%- if entry.authors -%}, {{ entry.authors | join: ", " }}{%- endif -%}
        {%- if entry.publisher -%}, <em>{{ entry.publisher
            | replace: "Spotlight", "<strong>Spotlight</strong>"
            | replace: "Oral",      "<strong>Oral</strong>" }}</em>{%- endif -%}
        {%- if entry.note -%}, <em>{{ entry.note
            | replace: "Spotlight", "<strong>Spotlight</strong>"
            | replace: "Oral",      "<strong>Oral</strong>" }}</em>{%- endif -%}
      </div>
    </li>
  {% endfor %}
</ul>
