<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in data[1] %}
    <li class="list-group-item">
      <div class="row">

        <!-- LEFT COLUMN -->
        <div class="col-xs-2 col-sm-2 col-md-2 date-column">

          {%- assign start_str = '' -%}
          {%- assign end_str = '' -%}

          {%- if content.startDate -%}
            {%- assign start_str = content.startDate | date: "%b %Y" -%}
          {%- endif -%}

          {%- if content.endDate -%}
            {%- assign end_str = content.endDate | date: "%b %Y" -%}
          {%- else -%}
            {%- assign end_str = "Present" -%}
          {%- endif -%}

          <div class="text-dark text-center">
            {%- if content.startDate -%}
              {{ start_str }} – {{ end_str }}
            {%- elsif content.endDate -%}
              {{ end_str }}
            {%- endif -%}
          </div>

          {%- if content.company or content.location -%}
            <div class="text-dark text-left mt-1">
              {%- if content.company -%}
                <p class="mb-0">{{ content.company }}</p>
              {%- endif -%}
              {%- if content.location -%}
                <p class="mb-0">{{ content.location }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}

        </div>

        <!-- RIGHT COLUMN -->
        <div class="col-xs-10 col-sm-10 col-md-10 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4">
            {% if content.url %}
              <a href="{{ content.url }}">{{ content.name }}</a>
            {% else %}
              {{ content.name }}
            {% endif %}
          </h6>

          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">
            {{ content.summary }}
          </h6>

          <ul class="items">
            {% for item in content.highlights %}
              <li><span class="item">{{ item }}</span></li>
            {% endfor %}
          </ul>
        </div>

      </div>
    </li>
  {% endfor %}
</ul>
